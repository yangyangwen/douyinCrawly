DOUYIN_HOST=0.0.0.0
DOUYIN_PORT=8000
DOUYIN_API_AUTH_TOKEN=replace-with-a-strong-random-token

# Optional: override Docker base images when Docker Hub is unavailable.
# DOUYIN_FRONTEND_BUILD_IMAGE=node:20-bookworm-slim
# DOUYIN_PYTHON_RUNTIME_IMAGE=python:3.12-slim-bookworm

# Optional: override config/settings.json on startup.
DOUYIN_COOKIE=
DOUYIN_USER_AGENT=

# Optional download/runtime settings.
DOUYIN_MAX_RETRIES=3
DOUYIN_MAX_CONCURRENCY=5
DOUYIN_ENABLE_INCREMENTAL_FETCH=true

# Optional Aria2 settings.
DOUYIN_ARIA2_HOST=localhost
DOUYIN_ARIA2_PORT=6800
DOUYIN_ARIA2_SECRET=douyin_crawler_default_secret
