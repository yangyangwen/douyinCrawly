DOUYIN_HOST=0.0.0.0
DOUYIN_PORT=8000

# Optional: override config/settings.json on startup.
DOUYIN_COOKIE=
DOUYIN_USER_AGENT=

# Optional download/runtime settings.
DOUYIN_MAX_RETRIES=3
DOUYIN_MAX_CONCURRENCY=5
DOUYIN_ENABLE_INCREMENTAL_FETCH=true

# Optional Aria2 settings.
DOUYIN_ARIA2_HOST=localhost
DOUYIN_ARIA2_PORT=6800
DOUYIN_ARIA2_SECRET=douyin_crawler_default_secret
